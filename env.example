# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT signing secret -- REQUIRED. Generate a unique value, e.g. `openssl rand -hex 32`.
# The app refuses to start if this is unset or left at a known placeholder.
JWT_SECRET=

# Optional but strongly recommended: encrypts the stored Telegram credentials at rest --
# session strings, per-account API hashes and passkey private keys. Without it they sit in
# the SQLite file as plain text, so a copy of the data volume (a backup, a snapshot, a
# mounted disk) is every account on the panel.
#
# Generate a unique value, e.g. `openssl rand -hex 32`. Deliberately separate from
# JWT_SECRET: rotating the JWT secret is routine and must not destroy stored sessions.
#
# READ BEFORE SETTING: keep this key safe and back it up. Lose it and the encrypted values
# cannot be recovered -- every account has to be authenticated again. Turning it on encrypts
# what is already stored on the next start; turning it off again does NOT decrypt, so remove
# it only if you are willing to re-authenticate.
# BEMBY_DATA_KEY=

# Optional: timezone for scheduled jobs (defaults to UTC)
# TZ=Australia/Sydney

# Optional: override the listen port (defaults to 3000)
# PORT=3000

# Optional: override the SQLite database path (defaults to /app/data/bemby.db)
# DB_PATH=/app/data/bemby.db

# Optional: enable bulk account management (disabled by default).
# Set to 1 (or true) to show the "Bulk Add" and "Bulk Clean" buttons and enable
# their API routes.
# BULK_ACCOUNT_MANAGEMENT=1

# Optional: enable the data store (disabled by default).
# Set to 1 (or true) for the Data menu entry, its Settings toggle, its job steps
# (read/save/delete a record) and the {data.folder.key} placeholders. Left off,
# none of it is offered and the panel stays simpler.
# DATA_MANAGEMENT=1

# Optional: enable the msOauth2api integration (disabled by default).
# Set to 1 (or true) for the Settings section that points Bemby at a self-hosted
# msOauth2api install, the option to give a Telegram account a login email leased
# from its address pool, and the page steps that take an address and read the code
# sent to it. Left off, none of it is offered and nothing mentions it.
# MSOAUTH2API=1

# Optional: number of reverse proxy hops in front of this app (defaults to 0)
# Set to 1 if behind nginx/Caddy/Traefik, 2 if behind Cloudflare + nginx, etc.
# Required for rate limiting to work correctly when behind a proxy.
# TRUST_PROXY=1

# ── Telegram call bounds (a dead proxy would otherwise hang forever) ──────────
# Wall-clock bound on one Telegram operation (2FA change, session/passkey/profile
# calls). Past this the account fails with a timeout and a bulk run moves on.
# TG_OP_TIMEOUT_SECONDS=120

# Same, for connecting a live chat client.
# TG_CONNECT_TIMEOUT_SECONDS=90

# ── Memory bounds (matter on a small host, e.g. 2GB) ──────────────────────────
# Each connected Telegram account costs several MB of client state plus a socket.
# Clients nobody is watching are evicted once there are more than this many.
# TG_LIVE_CLIENT_MAX=8

# Inline chat media is buffered whole to serve it, so a large video spikes memory
# by its full size. Anything bigger than this is refused. (MB)
# TG_MEDIA_MAX_MB=25

# Outgoing file uploads are held in memory for the duration of the send. (MB)
# TG_UPLOAD_MAX_MB=50

# How often memory is sampled and persisted, in seconds. The watermark is what survives
# an OOM kill, so a longer interval means a staler final reading.
# MEMORY_SAMPLE_SECONDS=30

# Warn in the log once RSS passes this share of the limit, naming the job in flight.
# MEMORY_WARN_PERCENT=75

# V8 heap ceiling. The image sets --max-old-space-size=512, which suits a 2GB host;
# raise it on a bigger one. Overriding this variable replaces the image default, so
# repeat any other flags you need.
# NODE_OPTIONS=--max-old-space-size=1024

# Optional: CloakBrowser licence key for the Cloudflare solver's browser. Without one it
# runs the older free build, which passes fewer challenges as detection moves on; a free
# key (one per GitHub account, from https://cloakbrowser.dev/free) gets the current build.
# Set here it applies to every browser at once, which is only right for a paid key -- a
# free key allows one concurrent session. For free keys, add them in Settings instead,
# where one is leased per running browser.
# CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx

# Optional: launch a CloakBrowser build already on disk instead of the one the app
# resolves, e.g. to roll back to an older build. It must be a CloakBrowser binary: a stock
# Chromium has none of the fingerprint patches, so it does not solve anything.
# The previous solver's PUPPETEER_EXECUTABLE_PATH is no longer read at all -- if your .env
# still sets it, the line is dead and the browser it points at can be deleted.
# CLOAKBROWSER_BINARY_PATH=/app/data/cloakbrowser/chromium-150.0.7871.114.4-pro/chrome

# Optional: a second hostname for this same server -- another DNS name pointing at the same
# host and port is enough, no extra port and no certificate. Mini Apps opened in the messenger
# are then shown in the panel, served from this origin. Unset, they open in a browser tab.
#
# A separate origin is required rather than a path under the panel: a Mini App reads
# location.pathname to route itself, so it has to own "/" wherever it is served, and the panel
# already owns "/" on its own origin. Keep it on the same domain as the panel -- the viewer's
# ticket cookie is then same-site and needs no HTTPS, while the origin stays distinct, so the
# page still cannot reach the panel's stored session token.
# WEBVIEW_PUBLIC_ORIGIN=http://ports2.example.com:53333

# Optional: first loopback port used by tunnel exits imported from a node subscription
# (Settings -> Proxies -> Node subscription). Each node listens on one port from this
# range as SOCKS5, and keeps it across restarts. Change it only if something else on the
# host already answers here; the stored proxy URLs are rewritten on the next import.
# VLESS_PORT_BASE=24080
